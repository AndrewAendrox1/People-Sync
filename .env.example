NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27028/people-sync?replicaSet=rs0
# Generate a random 32-byte hex key. Required before storing sensitive identifiers.
DATA_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=People Sync <no-reply@example.com>
S3_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=

# Supabase Postgres pooled and direct connections; keep both server-only.
# With pg 8.23+, append ?sslmode=require&uselibpqcompat=true to both URLs.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Public project URL used by the API to verify Supabase Auth JWTs.
SUPABASE_URL=
# Browser-safe project URL and publishable key only. Never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional one-time import source. Do not use for normal application startup.
NEON_DATABASE_URL=
